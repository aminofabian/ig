generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Enums
enum UserRole {
  ADMIN
  USER
  VERIFIED_USER
}

enum SubscriptionStatus {
  ACTIVE
  INCOMPLETE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
  PAUSED
}

enum INTEGRATIONS {
  INSTAGRAM
}

enum MEDIATYPE {
  IMAGE
  VIDEO
  CAROSEL_ALBUM
}

enum LISTENERS {
  SMARTAI
  MESSAGE
}

// Core models
model Message {
  id         String   @id @default(cuid())
  content    String
  fromUserId String   // Make sure these field names match
  toUserId   String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
}

model User {
  id                 String          @id @default(cuid())
  firstName          String?
  lastName           String?
  email              String?         @unique
  emailVerified      DateTime?       @map("email_verified")
  image              String?
  password           String?
  role               String          @default("USER")
  status             String          @default("Active")
  isTwoFactorEnabled Boolean         @default(false)
  instagram          String?
  website            String?
  location           String?
  bio                String?
  username           String?         @unique @default(cuid())
  twitter            String?
  linkedin           String?
  github             String?
  youtube            String?
  facebook           String?
  discord            String?
  tiktok             String?
  subscription       Subscription?
  integrations       Integration[]
  automations        Automation[]
  hashtags           Hashtag[]
  hashtagSearches    HashtagSearch[]
  accounts           Account[]
  instagramSnapshots InstagramSnapshot[]
  sentMessages       Message[]       @relation("SentMessages")
  receivedMessages   Message[]       @relation("ReceivedMessages")

  // Instagram Profile Fields
  instagramProfileId String?   @unique
  instagramVerified  Boolean?  @default(false)
  instagramPrivate   Boolean?  @default(false)
  postsCount         Int?      @default(0)
  followersCount     Int?      @default(0)
  followingCount     Int?      @default(0)
  instagramBio       String?   // separate from existing bio
  instagramFullName  String?
  instagramImage     String?   // separate from existing image

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// Integration models
model Integration {
  id          String       @id @default(cuid())
  userId      String
  name        String
  token       String
  expiresAt   DateTime?
  username    String?
  instagramId String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations Automation[]

  @@unique([userId, name])
  @@map("integrations")
}

// Subscription models
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  status               String    @default("active")
  priceId              String
  customerId           String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  features             Json
  metadata             Json?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceId     String   @unique
  price       Float
  interval    String
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subscription_plans")
}

// Automation models
model Automation {
  id            String           @id @default(cuid())
  name          String          @default("New Automation")
  userId        String
  integrationId String
  type          String
  status        String
  config        Json
  stats         Json?
  active        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration   Integration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tasks         AutomationTask[]
  triggers      Trigger[]
  listener      Listener?
  dms           Dms[]
  keywords      Keyword[]
  posts         AutomationPost[]

  @@index([userId])
  @@index([integrationId])
  @@map("automations")
}

model AutomationTask {
  id           String     @id @default(cuid())
  automationId String
  status       String
  result       Json?
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_tasks")
}

model AutomationPost {
  id           String     @id @default(cuid())
  postid       String
  caption      String?
  media        String
  mediaType    MEDIATYPE  @default(IMAGE)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_posts")
}

model Dms {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id])
  createdAt    DateTime   @default(now())
  senderId     String?
  reciever     String?
  message      String?

  @@index([automationId])
  @@map("dms")
}

model Listener {
  id           String     @id @default(cuid())
  automationId String     @unique
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  listener     LISTENERS  @default(MESSAGE)
  prompt       String
  commentReply String?
  dmCount      Int        @default(0)
  commentCount Int        @default(0)

  @@index([automationId])
  @@map("listeners")
}

model Trigger {
  id           String     @id @default(cuid())
  type         String
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("triggers")
}

model Keyword {
  id           String     @id @default(cuid())
  word         String
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, word])
  @@index([automationId])
  @@map("keywords")
}

// Hashtag models
model Hashtag {
  id                String            @id @default(cuid())
  userId            String
  name              String
  postsCount        Int               @default(0)
  avgLikes          Float             @default(0)
  avgComments       Float             @default(0)
  searchedAt        DateTime          @default(now())
  hashtagSearchId   String?
  relatedHashtags   HashtagRelation[] @relation("HashtagToRelated")
  relatedToHashtags HashtagRelation[] @relation("RelatedToHashtag")
  posts             Post[]
  user              User              @relation(fields: [userId], references: [id])
  hashtagSearch     HashtagSearch?    @relation(fields: [hashtagSearchId], references: [id])

  @@index([userId])
  @@index([hashtagSearchId])
  @@map("hashtags")
}

model HashtagRelation {
  id               String   @id @default(cuid())
  hashtagId        String
  relatedHashtagId String
  createdAt        DateTime @default(now())
  hashtag          Hashtag  @relation("HashtagToRelated", fields: [hashtagId], references: [id], onDelete: Cascade)
  relatedHashtag   Hashtag  @relation("RelatedToHashtag", fields: [relatedHashtagId], references: [id], onDelete: Cascade)

  @@unique([hashtagId, relatedHashtagId])
  @@index([hashtagId])
  @@index([relatedHashtagId])
  @@map("hashtag_relations")
}

model Post {
  id           String   @id @default(cuid())
  hashtagId    String
  postId       String
  caption      String?
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  postedAt     DateTime
  createdAt    DateTime @default(now())
  hashtag      Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@index([hashtagId])
  @@index([postId])
  @@map("hashtag_posts")
}

model HashtagSearch {
  id        String    @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  hashtags  Hashtag[]
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([query])
  @@map("hashtag_searches")
}

model InstagramSnapshot {
  id            String   @id @default(cuid())
  userId        String
  timestamp     DateTime @default(now())
  postsCount    Int
  followersCount Int
  followingCount Int
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("instagram_snapshots")
}

model Lead {
  id              String   @id @default(cuid())
  username        String   @unique
  fullName        String?
  profilePicUrl   String?
  followers       Int      @default(0)
  following       Int      @default(0)
  posts           Int      @default(0)
  biography       String?
  website         String?
  isBusiness      Boolean  @default(false)
  businessCategory String?
  engagementRate  Float    @default(0)
  sourceHashtag   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceHashtag])
  @@index([followers])
  @@index([engagementRate])
}